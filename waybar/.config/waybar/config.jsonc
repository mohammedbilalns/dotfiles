{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/submap",
        "custom/screenshot"
    ],

    "modules-center": [
        "hyprland/window",
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "tray",
        "custom/power"
    ],

    // Modules Configuration
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun || wofi --show drun",
        "tooltip-format": "Application Launcher"
    },

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "disable-scroll": false,
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "format": "{name} {icon}",
        "format-icons": {
            "1": "󰋜",
            "2": "󰈹",
            "3": "󰅩",
            "4": "󰓓",
            "5": "󰓇",
            "6": "󰙯",
            "urgent": "󰵙",
            "focused": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "hyprland/submap": {
        "format": "󰌌 <span color='#a6e3a1'>{}</span>",
        "max-length": 12,
        "tooltip": false
    },

    "custom/screenshot": {
        "format": "󰄄",
        "on-click": "grimshot save output && notify-send 'Screenshot Saved'",
        "tooltip-format": "Take Screenshot"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 45,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*) - Google Chrome": " $1",
            "(.*) - Visual Studio Code": "󰨞 $1",
            "(.*) - Code - OSS": "󰨞 $1",
            "kitty (.*)": " $1",
            "foot (.*)": " $1",
            "Alacritty": " Terminal",
            "Thunar (.*)": "󰝰 $1",
            "Spotify": "󰓇 Spotify",
            "Discord (.*)": "󰙯 $1"
        }
    },

    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%A, %B %d, %Y  󰥔 %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "󰘚 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "network": {
        "format-wifi": "󰤨 {bandwidthDownBytes}",
        "format-ethernet": "󰈀 {bandwidthDownBytes}",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 2,
        "on-click": "nm-connection-editor || nmtui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle || ~/.config/waybar/volume --toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5% || ~/.config/waybar/volume --inc",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5% || ~/.config/waybar/volume --dec"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "wlogout || hyprlock || loginctl terminate-user $USER",
        "tooltip-format": "Power Menu"
    }
}
