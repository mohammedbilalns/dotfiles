#!/usr/bin/env bash

set -euo pipefail

INPUT_FILE="${1:-magnets.txt}"
DOWNLOAD_DIR="${2:-downloads}"
MAX_PARALLEL="${3:-5}"

# Check dependencies
if ! command -v aria2c &> /dev/null; then
    echo "❌ aria2c not installed. Install it first."
    exit 1
fi

# Check input file
if [[ ! -f "$INPUT_FILE" ]]; then
    echo "❌ Input file not found: $INPUT_FILE"
    exit 1
fi

mkdir -p "$DOWNLOAD_DIR"

echo "📥 Starting bulk torrent download..."
echo "📄 Input file: $INPUT_FILE"
echo "📂 Output dir: $DOWNLOAD_DIR"
echo "⚡ Parallel downloads: $MAX_PARALLEL"
echo "-------------------------------------"

# Function to download a single magnet
download_magnet() {
    local magnet="$1"

    aria2c \
        --dir="$DOWNLOAD_DIR" \
        --seed-time=0 \
        --enable-dht=true \
        --bt-enable-lpd=true \
        --bt-max-peers=50 \
        --max-connection-per-server=16 \
        --split=16 \
        --min-split-size=5M \
        "$magnet"
}

export -f download_magnet
export DOWNLOAD_DIR

# Run downloads in parallel
cat "$INPUT_FILE" | grep -v '^$' | xargs -I{} -P "$MAX_PARALLEL" bash -c 'download_magnet "$@"' _ {}

echo "✅ All downloads started/completed."
