{
    "layer": "top",
    "position": "bottom",
    "height": 20,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
        "cffi/niri-taskbar"
    ],

    "modules-center": [],

    "modules-right": [
        "custom/pomodoro",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "tray",
        "clock"
    ],

    // Niri Workspaces
    "niri/workspaces": {
        "format": "{value}"
    },

    // Niri Taskbar (CFFI module)
    "cffi/niri-taskbar": {
        "module_path": "/usr/lib/waybar/libniri_taskbar.so",
        "apps": {
            "signal": [
                {
                    "match": "\\([0-9]+\\)$",
                    "class": "unread"
                }
            ]
        }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 24,
        "tooltip": false
    },

    // Custom Pomodoro
    "custom/pomodoro": {
        "format": "{}",
        "return-type": "json",
        "exec": "waybar-module-pomodoro -w 25",
        "on-click": "waybar-module-pomodoro toggle",
        "on-click-right": "waybar-module-pomodoro reset"
    },

    // Clock
    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%A, %B %d, %Y  󰥔 %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // Network
    "network": {
        "format-wifi": "󰤨 {bandwidthDownBytes}",
        "format-ethernet": "󰈀 {bandwidthDownBytes}",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 2,
        "on-click": "nm-connection-editor || nmtui"
    },

    // Audio
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle || ~/.config/waybar/volume --toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5% || ~/.config/waybar/volume --inc",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5% || ~/.config/waybar/volume --dec"
    },

    // Backlight
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    // Battery
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    // Tray
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    // Hardware Modules
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "󰘚 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },

    // Custom Launcher & Actions
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun || wofi --show drun",
        "tooltip-format": "Application Launcher"
    },

    "custom/screenshot": {
        "format": "󰄄",
        "on-click": "grimshot save output && notify-send 'Screenshot Saved'",
        "tooltip-format": "Take Screenshot"
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "wlogout || hyprlock || loginctl terminate-user $USER",
        "tooltip-format": "Power Menu"
    },

    "custom/tomat": {
        "exec": "tomat status",
        "interval": 1,
        "return-type": "json",
        "format": "{}",
        "on-click": "tomat toggle",
        "on-click-right": "tomat skip"
    }
}
